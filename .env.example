## Runtime

#_ cpu/mps/cuda
# DEVICE=cpu

#_ empty=PyPI (auto CUDA or MPS), cpu=CPU, cu121/cu128/...=CUDA version
# PYTORCH_BACKEND=

## Model cache (optional)

# HF_HOME=/path/to/cache/huggingface
# TORCH_HOME=/path/to/cache/torch
# GIGAAM_CACHE_DIR=/path/to/cache/gigaam
# SHERPA_HOME=/path/to/cache/sherpa
# RESONANCE_CACHE_DIR=/path/to/cache/resonance

## Server

# RESONANCE_PORT=8000

#_ DEBUG / INFO / WARNING / ERROR
# RESONANCE_LOG_LEVEL=INFO

# RESONANCE_LOG_TO_FILE=0
# RESONANCE_LOG_FILE=/path/to/server.log

#_ 0 = unlimited
# RESONANCE_UPLOAD_LIMIT_MB=0

#_ Optional CORS override (comma-separated)
#_ Default: http://localhost:${RESONANCE_PORT}
# RESONANCE_CORS_ORIGINS=http://localhost:8000

## IPC (optional)

# RESONANCE_IPC_PATH=/path/to/ipc.sock

## Retention

#_ TTS WAV files under <temp>/resonance-tts/; delete when older than TTL (seconds)
# RESONANCE_TTS_FILE_TTL_SEC=5400
# RESONANCE_TTS_SWEEP_INTERVAL_SEC=900

## STT

# RESONANCE_SR=16000
# RESONANCE_CHUNK_SEC=20
# RESONANCE_STT_MAX_CONCURRENT_JOBS=2

#_ 0 = unlimited
# RESONANCE_STT_MAX_DURATION_SEC=0

# RESONANCE_ENABLE_SYSTEM_AUDIO=true

#_ Maximum time allowed for system-audio capture shutdown (seconds)
# RESONANCE_SYSTEM_CAPTURE_STOP_TIMEOUT_SEC=5

#_ Idle timeout for microphone live STT (seconds); 0 disables expiration
# RESONANCE_LIVE_STT_IDLE_TIMEOUT_SEC=15

## TTS

# RESONANCE_TTS_SR=48000
# RESONANCE_TTS_VOICE_ID=ru_roman

#_ Silero model limit (~safe max depends on voice/model)
# RESONANCE_TTS_MAX_CHARS=600

#_ 0 = unlimited
# RESONANCE_TTS_MAX_INPUT_CHARS=0

#_ Diarization clustering threshold (0.40 - 0.70). Lower = more speakers (aggressive splitting).
#_ Default 0.55 is empirically tuned for WeSpeaker ResNet34 on typical meeting audio.
# RESONANCE_DIARIZATION_THRESHOLD=0.55
