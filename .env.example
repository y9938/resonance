# cpu or cuda
DEVICE=cpu
# empty=PyPI (auto CUDA), cpu=CPU, cu121/cu128/...=CUDA version
PYTORCH_BACKEND=cpu

# STT Settings
RESONANCE_SR=16000
RESONANCE_CHUNK_SEC=20
RESONANCE_OVERLAP_SEC=2

# TTS Settings
RESONANCE_TTS_SR=48000
RESONANCE_TTS_SPEAKER=ru_roman
# Silero model limit (~800 is safe max)
RESONANCE_TTS_MAX_CHARS=600
# 0 = unlimited
RESONANCE_TTS_MAX_INPUT_CHARS=0

# Server Settings
RESONANCE_UPLOAD_LIMIT_MB=0
# Comma-separated origins
RESONANCE_CORS_ORIGINS=http://localhost:8000
# TTS WAV files under <temp>/resonance-tts/; delete when older than TTL (seconds)
RESONANCE_TTS_FILE_TTL_SEC=5400
RESONANCE_TTS_SWEEP_INTERVAL_SEC=900
